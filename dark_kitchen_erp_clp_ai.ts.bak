    selector: 'app-dashboard',
    standalone: true,
    changeDetection: ChangeDetectionStrategy.OnPush,
    template: `
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
            <!-- KPIs Dinámicos -->
            <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-6 rounded-2xl border border-green-500/20 bg-gray-900/40 backdrop-blur-xl group hover:border-green-500/40 transition-all">
                    <h4 class="text-[11px] text-gray-500 font-bold uppercase tracking-[0.2em] mb-2">Utilidad Operativa</h4>
                    <p class="text-3xl font-black tracking-tight" [class.text-green-400]="metrics().netProfit >= 0" [class.text-red-400]="metrics().netProfit < 0">
                        {{ formatCLP(metrics().netProfit) }}
                    </p>
                    <div class="mt-2 h-1 w-full bg-gray-800 rounded-full overflow-hidden">
                        <div class="h-full bg-green-500" [style.width.%]="75"></div>
                    </div>
                </div>
                
                <div class="p-6 rounded-2xl border border-blue-500/20 bg-gray-900/40 backdrop-blur-xl">
                    <h4 class="text-[11px] text-gray-500 font-bold uppercase tracking-[0.2em] mb-2">Ventas Brutas</h4>
                    <p class="text-2xl font-bold text-blue-400">{{ formatCLP(metrics().totalRevenue) }}</p>
                </div>

                <div class="p-6 rounded-2xl border border-red-500/20 bg-gray-900/40 backdrop-blur-xl">
                    <h4 class="text-[11px] text-gray-500 font-bold uppercase tracking-[0.2em] mb-2">Gastos Totales</h4>
                    <p class="text-2xl font-bold text-red-400">{{ formatCLP(metrics().totalExpenses) }}</p>
                </div>

                <!-- Alertas de Stock -->
                <div class="md:col-span-3 p-8 rounded-2xl border border-yellow-500/20 bg-gray-900/40">
                    <div class="flex justify-between items-center mb-6">
                        <h4 class="text-xl font-black text-yellow-400 flex items-center tracking-tighter uppercase italic">
                            <lucide-icon name="alert-triangle" class="w-6 h-6 mr-2"></lucide-icon> Quiebre de Stock
                        </h4>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @for (item of metrics().lowStockItems; track item.id) {
                            <div class="flex flex-col p-4 bg-yellow-950/20 border border-yellow-500/10 rounded-xl hover:bg-yellow-950/30 transition-colors">
                                <span class="text-yellow-100 font-bold text-sm mb-1 uppercase">{{ item.name }}</span>
                                <div class="flex justify-between items-baseline">
                                    <span class="text-xs text-yellow-500/70">Quedan:</span>
                                    <span class="text-lg font-mono text-yellow-500">{{ item.quantity }}</span>
                                </div>
                            </div>
                        } @empty {
                            <div class="sm:col-span-3 text-center py-10 text-gray-600 border border-dashed border-gray-800 rounded-2xl font-mono text-xs">
                                ESCANEO DE INVENTARIO COMPLETO: SIN ALERTAS CRÍTICAS.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Columna IA -->
            <div class="lg:col-span-4">
                <app-ai-assistant [metrics]="metrics()" />
            </div>
        </div>
    `,
    imports: [LucideIconComponent, AiAssistantComponent]
})
class DashboardComponent {
    metrics = input.required<any>();
    formatCLP = formatCLP;
}

// --- APP ROOT (PUNTO DE ENTRADA) ---
@Component({
    selector: 'app-root',
    standalone: true,
    changeDetection: ChangeDetectionStrategy.OnPush,
    template: `
        <div class="min-h-screen bg-[#050505] text-gray-100 selection:bg-green-500/40 font-sans">
            <!-- Navbar de Cristal -->
            <header class="h-20 border-b border-gray-900 bg-black/80 backdrop-blur-2xl flex items-center justify-between px-8 sticky top-0 z-50">
                <div class="flex items-center space-x-4">
                    <div class="w-10 h-10 bg-green-600 rounded-xl flex items-center justify-center shadow-[0_0_30px_rgba(22,163,74,0.4)] transform rotate-3">
                        <lucide-icon name="cpu" class="text-white w-6 h-6"></lucide-icon>
                    </div>
                    <div>
                        <h1 class="text-2xl font-black tracking-tighter uppercase leading-none">Sentinel <span class="text-green-500">CLP</span></h1>
                        <p class="text-[9px] font-mono text-gray-500 tracking-[0.3em] uppercase">Dark Kitchen Intelligence</p>
                    </div>
                </div>
                
                <div class="hidden md:flex items-center space-x-6">
                    <div class="text-right">
                        <div class="text-[10px] font-mono text-green-500/60 uppercase">Estado Nodo</div>
                        <div class="text-xs font-bold text-green-400">{{ userId() ? 'AUTORIZADO' : 'CONECTANDO...' }}</div>
                    </div>
                    <div class="w-10 h-10 rounded-full border border-gray-800 bg-gray-900 flex items-center justify-center text-xs font-bold text-gray-400">
                        {{ (userId() || 'U').substring(0,2).toUpperCase() }}
                    </div>
                </div>
            </header>

            <div class="flex flex-col lg:flex-row">
                <!-- Sidebar Táctica -->
                <nav class="lg:w-24 border-r border-gray-900 p-6 flex lg:flex-col lg:h-[calc(100vh-80px)] space-x-4 lg:space-x-0 lg:space-y-6 bg-black">
                    <button (click)="activeView.set('dashboard')" 
                        [class]="'flex items-center justify-center w-full aspect-square rounded-2xl transition-all duration-300 ' + (activeView() === 'dashboard' ? 'bg-green-600 text-white shadow-lg shadow-green-900/20 scale-105' : 'text-gray-700 hover:bg-gray-900 hover:text-gray-300')">
                        <lucide-icon name="home" class="w-7 h-7"></lucide-icon>
                    </button>
                    <button class="flex items-center justify-center w-full aspect-square rounded-2xl text-gray-800 cursor-not-allowed border border-dashed border-gray-900">
                        <lucide-icon name="package" class="w-7 h-7"></lucide-icon>
                    </button>
                    <button class="flex items-center justify-center w-full aspect-square rounded-2xl text-gray-800 cursor-not-allowed border border-dashed border-gray-900">
                        <lucide-icon name="wallet" class="w-7 h-7"></lucide-icon>
                    </button>
                </nav>

                <!-- Área de Operaciones -->
                <main class="flex-grow p-8 lg:h-[calc(100vh-80px)] overflow-y-auto custom-scrollbar">
                    @if (loading()) {
                        <div class="flex flex-col items-center justify-center h-full">
                            <div class="w-12 h-12 border-4 border-green-500/10 border-t-green-500 rounded-full animate-spin shadow-[0_0_20px_rgba(34,197,94,0.2)]"></div>
                            <p class="mt-6 text-[11px] font-mono text-gray-500 tracking-widest uppercase animate-pulse">Cargando módulos tácticos...</p>
                        </div>
                    } @else {
                        @if (activeView() === 'dashboard') {
                            <app-dashboard [metrics]="metrics()" />
                        }
                    }
                </main>
            </div>
        </div>
    `,
    imports: [LucideIconComponent, DashboardComponent],
    styles: [`
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1a1a1a; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #22c55e; }
    `]
})
export class App {
    userId = signal<string | null>(null);
    loading = signal(true);
    activeView = signal('dashboard');
    
    // Señales de Estado (Datos de Firestore)
    sales = signal<Sale[]>([]);
    expenses = signal<Expense[]>([]);
    inventory = signal<InventoryItem[]>([]);

    // Computación de Métricas en Tiempo Real
    metrics = computed(() => {
        const totalRevenue = this.sales().reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
        const totalExpenses = this.expenses().reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
        const lowStockItems = this.inventory().filter(item => (Number(item.quantity) || 0) < LOW_STOCK_THRESHOLD);
        return { totalRevenue, totalExpenses, netProfit: totalRevenue - totalExpenses, lowStockItems };
    });

    constructor() {
        this.initFirebase();
    }

    private async initFirebase() {
        if (!firebaseConfig) {
            this.loading.set(false);
            console.warn("Firestore config missing. Usando modo offline.");
            return;
        }

        try {
            const app = initializeApp(firebaseConfig);
            const auth = getAuth(app);
            const db = getFirestore(app);

            // Regla de Oro: Auth -> Firestore
            if (initialAuthToken) {
                await signInWithCustomToken(auth, initialAuthToken).catch(async () => await signInAnonymously(auth));
            } else {
                await signInAnonymously(auth);
            }

            onAuthStateChanged(auth, (user) => {
                if (user) {
                    this.userId.set(user.uid);
                    this.startRealtimeSync(db);
                    this.loading.set(false);
                }
            });
        } catch (e) {
            console.error("Firebase Critical Error", e);
            this.loading.set(false);
        }
    }

    private startRealtimeSync(db: Firestore) {
        // Rutas dinámicas según estructura obligatoria /artifacts/{appId}/public/data/
        const getPath = (col: string) => `artifacts/${appId}/public/data/${col}`;
        
        onSnapshot(collection(db, getPath('sales')), (snap) => {
            this.sales.set(snap.docs.map(d => ({ id: d.id, ...d.data() })) as Sale[]);
        }, (err) => console.error("Sales Error", err));

        onSnapshot(collection(db, getPath('expenses')), (snap) => {
            this.expenses.set(snap.docs.map(d => ({ id: d.id, ...d.data() })) as Expense[]);
        }, (err) => console.error("Expenses Error", err));

        onSnapshot(collection(db, getPath('inventory')), (snap) => {
            this.inventory.set(snap.docs.map(d => ({ id: d.id, ...d.data() })) as InventoryItem[]);
        }, (err) => console.error("Inventory Error", err));
    }
}